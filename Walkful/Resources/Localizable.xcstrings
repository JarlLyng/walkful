    "Start walking": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Begynd at gå"
          }
        }
      }
    },
    "Step %lld of 4": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Trin %lld af 4"
          }
        }
      }
    },
    "Steps · avg %@/day": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skridt · gns. %@/dag"
          }
        }
      }
    },
    "Steps · avg %@/month": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skridt · gns. %@/måned"
          }
        }
      }
    },
    "Steps · by month": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skridt · pr. måned"
          }
        }
      }
    },
    "Still 100% private": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stadig 100 % privat"
          }
        }
      }
    },
    "Strong-benefit zone": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Zone med stor gevinst"
          }
        }
      }
    },
    "THIS WEEK": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "DENNE UGE"
          }
        }
      }
    },
    "That's %lld marathons. Keep wending.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "That's %lld marathon. Keep wending."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "That's %lld marathons. Keep wending."
                }
              }
            }
          }
        },
        "da": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Det er %lld maraton. Bliv ved med at gå."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Det er %lld maratoner. Bliv ved med at gå."
                }
              }
            }
          }
        }
      }
    },
    "This device doesn't provide Apple Health data.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enhed leverer ikke data fra Apple Health."
          }
        }
      }
    },
    "This is your year, once you unlock Pro": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sådan ser dit år ud, når du låser Pro op"
          }
        }
      }
    },
    "This month": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne måned"
          }
        }
      }
    },
    "This week": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne uge"
          }
        }
      }
    },
    "Time to move": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tid til at røre dig"
          }
        }
      }
    },
    "Today": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I dag"
          }
        }
      }
    },
    "Touch and hold your Home Screen, tap Edit, then Add Widget and search for Walkful. There's a ring, a \"This week\" view, and Lock Screen widgets.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold fingeren nede på hjemmeskærmen, tryk Redigér, derefter Tilføj widget, og søg efter Walkful. Der er en ring, en visning for denne uge og widgets til låseskærmen."
          }
        }
      }
    },
    "Turn on reminders": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå påmindelser til"
          }
        }
      }
    },
    "Units": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Enheder"
          }
        }
      }
    },
    "Unlock Pro · %@": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås Pro op · %@"
          }
        }
      }
    },
    "Unlock Walkful Pro": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås Walkful Pro op"
          }
        }
      }
    },
    "Unlock the parts that help you move more — once, forever.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lås de dele op, der hjælper dig med at bevæge dig mere. Én gang, for altid."
          }
        }
      }
    },
    "Until": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Til"
          }
        }
      }
    },
    "Walkful": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Walkful"
          }
        }
      }
    },
    "Walkful Pro": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Walkful Pro"
          }
        }
      }
    },
    "Walkful can remind you to break up long sitting with a short walk or the stairs — a couple of times a day at most. Fully optional.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Walkful kan minde dig om at bryde langvarig stillesidden med en kort gåtur eller trapperne, højst et par gange om dagen. Helt valgfrit."
          }
        }
      }
    },
    "Walkful needs permission to read your activity from Apple Health. Turn it on in Settings → Health → Data Access & Devices → Walkful, or add some steps in the Health app.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Walkful skal have tilladelse til at læse din aktivitet fra Apple Health. Slå det til under Indstillinger → Sundhed → Dataadgang og enheder → Walkful, eller tilføj nogle skridt i Sundhed-appen."
          }
        }
      }
    },
    "Walkful only reminds you when you've actually been sitting a while, within these hours — at most a couple of times a day.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Walkful minder dig kun, når du faktisk har siddet stille et stykke tid, og kun i disse timer, højst et par gange om dagen."
          }
        }
      }
    },
    "Walkful reads your steps to show today's progress. Your data never leaves your device — we have no servers.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Walkful læser dine skridt for at vise dagens fremskridt. Dine data forlader aldrig din enhed, for vi har ingen servere."
          }
        }
      }
    },
    "Walkful reads your steps, distance and stairs to show your progress. Your data never leaves your device — we have no servers.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Walkful læser dine skridt, distance og etager for at vise dit fremskridt. Dine data forlader aldrig din enhed, for vi har ingen servere."
          }
        }
      }
    },
    "We couldn't verify that purchase. If you were charged, tap Restore purchase.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi kunne ikke bekræfte købet. Er du blevet trukket, så tryk Gendan køb."
          }
        }
      }
    },
    "We suggest 7,000 — research links it to far lower mortality than 2,000. Not 10,000, which is a myth.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi foreslår 7.000. Forskningen forbinder det med markant lavere dødelighed end 2.000. Ikke 10.000, som er en myte."
          }
        }
      }
    },
    "Week": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uge"
          }
        }
      }
    },
    "Welcome to Walkful": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Velkommen til Walkful"
          }
        }
      }
    },
    "Year": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "År"
          }
        }
      }
    },
    "You completed %lld brisk intervals — about %lld brisk minutes. Every step counts.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du gennemførte %lld raske intervaller, cirka %lld raske minutter. Hvert skridt tæller."
          }
        }
      }
    },
    "You move most in the afternoons. Planning a walk then makes it easier to hit your goal.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bevæger dig mest om eftermiddagen. Planlægger du en gåtur der, bliver målet nemmere at nå."
          }
        }
      }
    },
    "You move most in the evenings. Planning a walk then makes it easier to hit your goal.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bevæger dig mest om aftenen. Planlægger du en gåtur der, bliver målet nemmere at nå."
          }
        }
      }
    },
    "You move most in the mornings. Planning a walk then makes it easier to hit your goal.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bevæger dig mest om formiddagen. Planlægger du en gåtur der, bliver målet nemmere at nå."
          }
        }
      }
    },
    "You move most late at night. Planning a walk then makes it easier to hit your goal.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bevæger dig mest sent om natten. Planlægger du en gåtur der, bliver målet nemmere at nå."
          }
        }
      }
    },
    "You're on a %lld-day streak, your best ever. A walk today keeps it going.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er på en %lld-dages stime, din bedste nogensinde. En gåtur i dag holder den i gang."
          }
        }
      }
    },
    "You're on a %lld-day streak. Your best is %lld. A walk today keeps it going.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er på en %lld-dages stime. Din bedste er %lld. En gåtur i dag holder den i gang."
          }
        }
      }
    },
    "You've been still for a while — a short walk or the stairs?": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du har siddet stille et stykke tid. En kort gåtur eller trapperne?"
          }
        }
      }
    },
    "Your best is %lld days.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din bedste er %lld dage."
          }
        }
      }
    },
    "Your best time": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bedste tidspunkt"
          }
        }
      }
    },
    "Your data": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dine data"
          }
        }
      }
    },
    "Your day-by-day step history as a CSV file — generated and shared on-device. Your data, your export.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din skridthistorik dag for dag som CSV-fil, lavet og delt på enheden. Dine data, din eksport."
          }
        }
      }
    },
    "Your goal rises in small steps as your recent average grows — never down. Adjust it any time.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit mål stiger i små trin, når dit gennemsnit vokser, og aldrig nedad. Du kan justere det når som helst."
          }
        }
      }
    },
    "Your purchase is waiting for approval (e.g. Ask to Buy). Walkful Pro unlocks once it's approved.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit køb afventer godkendelse, for eksempel Bed om at købe. Walkful Pro låses op, når det er godkendt."
          }
        }
      }
    },
    "Your quietest day is usually %@. Gentle reminders help you stay on track.": {
      "localizations": {
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din stilleste dag er typisk %@. Blide påmindelser hjælper dig med at holde fast."
          }
        }
      }
    },
